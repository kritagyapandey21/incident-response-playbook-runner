# Copy this file to .env (which is git-ignored) and fill in ONE provider.
# The agents use the first provider that is configured; with none, they run in deterministic mode.

# Groq (fast, free tier) - get a key at https://console.groq.com/keys  (starts with gsk_)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# xAI Grok - get a key at https://console.x.ai  (starts with xai-)
# XAI_API_KEY=
# XAI_MODEL=grok-4

# --- alternatives ---
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL_ID=gpt-4o-mini
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=
# ANTHROPIC_API_KEY=

# Force deterministic mode even when a key is present:
# IRP_LLM=off
